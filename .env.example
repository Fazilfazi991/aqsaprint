# Used only by server-side API routes. Never expose the service role key in browser code.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# SMTP credentials for website lead emails. Use an app password if required by your email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@aqsaprint.com
SMTP_PASS=your_email_password_or_app_password
LEADS_TO_EMAIL=info@aqsaprint.com
LEADS_FROM_EMAIL=info@aqsaprint.com
